[Unit]
Description=IncidentRelay Slack Socket Mode worker
After=network.target incidentrelay.service

[Service]
Type=simple
User=incidentrelay
Group=incidentrelay
WorkingDirectory=/var/www/incidentrelay

Environment=INCIDENTRELAY_CONFIG_FILE=/etc/incidentrelay/incidentrelay.conf
Environment=PYTHONUNBUFFERED=1
# Shared with the web service so Slack-side lifecycle events are
# visible in GET /metrics (see incidentrelay.service).
Environment=PROMETHEUS_MULTIPROC_DIR=/run/incidentrelay/metrics
RuntimeDirectory=incidentrelay
RuntimeDirectoryMode=0755

ExecStart=/usr/bin/python3 -m app.slack_worker

Restart=always
RestartSec=5

KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
