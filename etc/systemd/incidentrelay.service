[Unit]
Description=IncidentRelay Gunicorn service
After=network.target

[Service]
Type=simple

User=incidentrelay
Group=incidentrelay

WorkingDirectory=/var/www/incidentrelay

Environment=INCIDENTRELAY_CONFIG_FILE=/etc/incidentrelay/incidentrelay.conf
# Shared directory for multiprocess Prometheus metrics: the web workers
# and the scheduler/Telegram/Slack services below all write their counter
# files here, and GET /metrics merges them into one scrape.
Environment=PROMETHEUS_MULTIPROC_DIR=/run/incidentrelay/metrics
RuntimeDirectory=incidentrelay
RuntimeDirectoryMode=0755

ExecStart=/usr/local/bin/gunicorn \
    --workers 4 \
    --threads 2 \
    --timeout 120 \
    --bind 127.0.0.1:8080 \
    --access-logfile /var/log/incidentrelay/gun-incidentrelay.log \
    --error-logfile /var/log/incidentrelay/gun-incidentrelay_error.log \
    --capture-output \
    "app:create_app()"

Restart=always
RestartSec=5

KillSignal=SIGTERM
PrivateTmp=true

[Install]
WantedBy=multi-user.target
